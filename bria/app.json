{
  "expo": {
    "name": "Bria",
    "slug": "bria",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bria",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brighthouse.bria"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F3"
      },
      "package": "com.brighthouse.bria",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F3"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
